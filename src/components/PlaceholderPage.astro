---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { title: string; label: string; description: string; }
const { title, label, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="placeholder">
    <p class="eyebrow">GUANYUNSHANG / {label}</p>
    <h1>{title}<span aria-hidden="true">。</span></h1>
    <p class="muted">{description}</p>
    <div class="status"><span class="tag tag--pink">筹备中</span><p>内容正在整理，稍后在这里与你见面。</p></div>
    <a class="back-link" href="/">返回首页 <span aria-hidden="true">↗</span></a>
  </div>
</BaseLayout>
<style>
  .placeholder { max-width: 50rem; padding-block: var(--space-6) var(--space-7); }
  h1 { margin-block: var(--space-6); font-size: var(--text-hero); }
  h1 span { color: var(--color-muted); }
  .status { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-4); border-block: var(--border-thin); padding-block: var(--space-5); margin-block: var(--space-7); }
  .status p { margin: 0; font-size: var(--text-small); }
  .back-link { font-size: var(--text-small); font-weight: 700; }
</style>
