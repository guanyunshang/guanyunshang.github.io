---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="找不到这个页面" description="页面可能已移动，或链接输入有误。" noindex>
  <section class="not-found">
    <p class="error-code display" aria-hidden="true">404<span>。</span></p>
    <h1>这一页，暂时翻不到。</h1>
    <p class="muted">页面可能已移动，或链接输入有误。回到首页，继续探索吧。</p>
    <div class="error-links"><a href="/">回到首页 ↗</a><a href="/archives">查看文章归档 ↗</a></div>
  </section>
</BaseLayout>
<style>
  .not-found { max-width: 50rem; margin: 2.5rem auto; padding: 2.5rem 0; }
  .error-code { font-size: clamp(6.25rem, 18.75vw, 10rem); margin-bottom: 1.875rem; }
  .error-code span { color: var(--color-pink); }
  h1 { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-page-title); }
  .not-found > .muted { font-size: var(--text-summary); }
  .error-links { display: flex; flex-wrap: wrap; gap: 1.875rem; margin-top: 2.5rem; font-size: var(--text-small); }
</style>
