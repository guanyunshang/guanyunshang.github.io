---
import { categoryClass, formatDate, type PostSummary } from '../data/home';
interface Props { post?: PostSummary; }
const { post } = Astro.props;
---
<section class="featured-section" aria-labelledby="featured-heading">
  <div class="section-heading"><h2 id="featured-heading">精选文章</h2><span class="section-caption">值得慢慢读</span></div>
  {post ? (
    <article class="featured-post">
      {post.cover && <a href={post.href} tabindex="-1" aria-hidden="true"><img class="featured-cover" src={post.cover} alt="" width="960" height="540" loading="lazy" /></a>}
      <div class="featured-body">
        <span class:list={['tag', categoryClass(post.category)]}>{post.category}</span>
        {post.demo && <span class="tag tag--pink">演示占位</span>}
        <h3><a href={post.href}>{post.title}</a></h3>
        <p class="muted">{post.description}</p>
        <div class="post-meta">{post.pubDate ? <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time> : <span>发布日期待补充</span>}<span>约 {post.readingMinutes} 分钟阅读</span></div>
      </div>
    </article>
  ) : (
    <div class="featured-placeholder">
      <div class="placeholder-top"><span class="tag tag--pink">内容占位</span><span class="placeholder-mark" aria-hidden="true">✳</span></div>
      <p class="placeholder-title">为值得回看的思考，<br />留一个位置。</p>
      <p class="muted">精选文章待收录。</p>
      <span class="placeholder-footnote">一篇好文章，值得再次翻开。</span>
    </div>
  )}
</section>
<style>
  .featured-section { margin-bottom: var(--space-7); }
  .featured-post { border: var(--border-ink); border-radius: var(--radius-small); overflow: hidden; }
  .featured-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .featured-body { padding: var(--space-5); }
  h3 { margin-block: var(--space-4) var(--space-3); font-size: var(--text-post-title); }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .featured-placeholder { position: relative; padding: var(--space-5) var(--space-6); border: var(--border-ink); border-radius: var(--radius-small); border-left: 5px solid var(--color-pink); }
  .placeholder-top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .placeholder-mark { font-size: 2rem; line-height: 1; }
  .placeholder-title { margin-block: var(--space-5) var(--space-3); font-family: var(--font-heading); font-weight: 900; font-size: clamp(1.375rem, 3vw, 1.75rem); line-height: 1.5; }
  .featured-placeholder > .muted { font-size: 0.875rem; }
  .placeholder-footnote { display: block; margin-top: var(--space-5); padding-top: var(--space-3); border-top: var(--border-thin); font-size: 0.75rem; color: var(--color-muted); }
  @media (max-width: 47.999rem) { .featured-placeholder { padding: var(--space-5); } }
</style>
