---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostList from '../components/PostList.astro';
import Sidebar from '../components/Sidebar.astro';
import { getBlogPosts, getCategories, toSummary } from '../lib/blog';
const publishedPosts = (await getBlogPosts()).map(toSummary);
const featuredPost = publishedPosts.find((post) => post.featured);
const categories = getCategories(publishedPosts);
---

<BaseLayout>
  <section class="introduction" aria-labelledby="home-title">
    <p class="eyebrow intro-topics">研究 · 技术 · 学习 · 生活</p>
    <h1 id="home-title" class="display">GUANYUNSHANG</h1>
    <p class="subtitle"><span>一个人的思考索引</span></p>
    <p class="tagline">记录思考，探索世界。</p>
    <div class="topics" aria-label="记录主题">
      <span class="tag tag--blue">研究</span>
      <span class="tag tag--orange">技术</span>
      <span class="tag tag--yellow">学习</span>
      <span class="tag tag--green">生活</span>
    </div>
  </section>
  <FeaturedPost post={featuredPost} />
  <PostList posts={publishedPosts} />
  <Sidebar slot="sidebar" posts={publishedPosts} categories={categories} />
</BaseLayout>
<style>
  .introduction { padding-block: 0.75rem 3rem; margin-bottom: 3rem; border-bottom: var(--border-ink); }
  .intro-topics { color: var(--color-muted); font-size: 0.8125rem; }
  h1 { font-size: var(--text-hero); margin-block: 2rem 1rem; overflow-wrap: normal; }
  .subtitle { font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 900; line-height: 1.5; margin-bottom: 1rem; }
  .subtitle span { background: var(--color-pink); }
  .tagline { font-family: var(--font-heading); font-size: 1rem; color: var(--color-muted); }
  .topics { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  @media (max-width: 47.999rem) { h1 { font-size: clamp(1.5rem, 7.7vw, 3.5rem); } }
</style>
