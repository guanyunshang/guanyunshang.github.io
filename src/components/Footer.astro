---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <a class="footer-brand display" href="/">{site.name}</a>
        <p class="footer-description">收录想法、知识与生活记忆的个人记录。</p>
      </div>
      <p class="footer-motto">保持好奇，<br />继续探索<span>。</span></p>
    </div>
    <div class="footer-bottom eyebrow">
      <span>© {year} {site.name}</span>
      <div class="footer-links"><a href="/rss.xml">RSS 订阅</a><a href="#page-top">返回顶部 ↑</a><span>由 <a href="https://astro.build/">Astro</a> 构建</span></div>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--color-ink); color: var(--color-paper); padding-block: var(--space-7) var(--space-5); }
  .footer-top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-6); padding-bottom: var(--space-7); }
  .footer-brand { display: inline-block; text-decoration: none; margin-bottom: var(--space-3); font-size: var(--text-brand); }
  .footer-description { max-width: 34ch; margin: 0; font-size: var(--text-small); }
  .footer-motto { margin: 0; font-family: var(--font-heading); font-weight: 900; line-height: 1.4; color: var(--color-pink); font-size: var(--text-footer-motto); }
  .footer-motto span { color: var(--color-paper); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); padding-top: var(--space-4); letter-spacing: 0; border-top: 1.25px solid var(--color-muted); font-size: var(--text-meta); }
  .site-footer :focus-visible { outline-color: var(--color-pink); }
  .footer-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }
  @media (max-width: 47.999rem) { .footer-top { flex-direction: column; } }

</style>
