---
import { navigation, site } from '../config/site';
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand display" href="/" aria-label={`${site.name} 首页`}>{site.name}<span aria-hidden="true">.</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span>菜单</span><span class="menu-symbol" aria-hidden="true">+</span>
    </button>
    <nav id="primary-navigation" aria-label="主导航">
      {navigation.map(({ label, href, title }) => (
        <a href={href} aria-label={title} aria-current={pathname === href || (href !== '/' && pathname.startsWith(`${href}/`)) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('nav');
  if (header && toggle && nav) {
    header.dataset.menuReady = '';
    const setOpen = (open: boolean) => toggle.setAttribute('aria-expanded', String(open));
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
  }
</script>
<style>
  .site-header { border-bottom: var(--border-ink); }
  .header-inner { min-height: 6rem; display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
  .brand { font-size: 1.5rem; text-decoration: none; white-space: nowrap; }
  .brand span { background: var(--color-pink); padding-inline: 0.08em; margin-left: 0.08em; }
  nav { display: flex; gap: var(--space-6); align-items: center; }
  nav a { position: relative; padding: var(--space-2) 0; font-size: var(--text-small); font-weight: 700; letter-spacing: 0.06em; text-decoration: none; }
  nav a::after { content: ''; position: absolute; inset: auto 0 0; height: 3px; background: transparent; }
  nav a:hover::after { background: var(--color-rule); }
  nav a[aria-current='page']::after { background: var(--color-ink); }
  nav a[aria-current='page'] { background: linear-gradient(transparent 35%, var(--color-pink) 35%, var(--color-pink) 75%, transparent 75%); }
  .menu-toggle { display: none; }
  @media (width < 768px) {
    .header-inner { min-height: 5rem; flex-wrap: wrap; gap: 0 var(--space-3); padding-block: var(--space-4); }
    nav { flex-basis: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2) var(--space-4); margin-top: var(--space-4); padding-top: var(--space-3); border-top: var(--border-thin); }
    nav a { padding: var(--space-3) 0; }
    [data-menu-ready] .menu-toggle { display: inline-flex; align-items: center; gap: var(--space-3); border: var(--border-ink); border-radius: var(--radius-small); background: transparent; min-height: 44px; padding: var(--space-2) var(--space-3); font-family: var(--font-mono); font-size: 0.75rem; cursor: pointer; }
    [data-menu-ready] .menu-toggle[aria-expanded='false'] + nav { display: none; }
    .menu-symbol { font-size: 1.25rem; line-height: 1; }
    .menu-toggle[aria-expanded='true'] .menu-symbol { transform: rotate(45deg); }
  }
</style>
