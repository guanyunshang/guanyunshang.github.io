---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { canonicalUrl } from '../lib/seo';
interface Props { title?: string; description?: string; mainClass?: string; type?: 'website' | 'article'; publishedTime?: Date; image?: string; noindex?: boolean; }
const { title, description = site.description, mainClass, type = 'website', publishedTime, image = site.defaultImage, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const hasSidebar = Astro.slots.has('sidebar');
const origin = Astro.site ?? Astro.url.origin;
const canonical = canonicalUrl(Astro.url.pathname, origin);
const socialImage = new URL(image, origin).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F3EEE4" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={`${site.name} · 记录思考，探索世界。`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} 文章订阅`} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell" id="page-top">
      <a class="skip-link" href="#main-content">跳到主要内容</a>
      <Header />
      <main id="main-content" class:list={['site-main', 'container', mainClass]} tabindex="-1">
        {hasSidebar ? (
          <div class="content-grid">
            <div><slot /></div>
            <aside aria-label="侧栏"><slot name="sidebar" /></aside>
          </div>
        ) : <slot />}
      </main>
      <Footer />
    </div>
  </body>
</html>
