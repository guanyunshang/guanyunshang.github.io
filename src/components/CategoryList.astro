---
import { categoryClass } from '../data/home';
import { categoryId } from '../lib/blog';
interface Props { categories: { name: string; count: number }[]; }
const { categories } = Astro.props;
---
<section class="sidebar-section" aria-labelledby="categories-heading">
  <div class="sidebar-title-row"><h2 id="categories-heading" class="sidebar-heading">文章分类</h2><a class="text-link" href="/categories">全部分类 <span aria-hidden="true">↗</span></a></div>
  {categories.length ? (
    <ul class="category-list">
      {categories.map(({ name, count }) => (
        <li><a href={`/categories#${encodeURIComponent(categoryId(name))}`}><span class:list={['tag', categoryClass(name)]}>{name}</span><span class="category-count">{count} 篇</span></a></li>
      ))}
    </ul>
  ) : (
    <p class="sidebar-note muted">暂无分类，发布文章后在这里归类。</p>
  )}
</section>
<style>
  .category-list { list-style: none; padding: 0; margin: 0; }
  li + li { margin-top: var(--space-3); }
  li a { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); text-decoration: none; }
  .category-count { color: var(--color-muted); font-size: var(--text-small); }
</style>
